<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F7FA" />

            <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#23262B" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D3138" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#464C55" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="#3B4048" />

            <SolidColorBrush x:Key="BodyTextBrush" Color="#D9DDE4" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AEB5C0" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#858E9B" />

            <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2D3138" />
            <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#363B43" />
            <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#555D68" />

            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#202329" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#464C55" />

            <SolidColorBrush x:Key="ToggleOffBackgroundBrush" Color="#2D3138" />
            <SolidColorBrush x:Key="ToggleOffBorderBrush" Color="#464C55" />
            <SolidColorBrush x:Key="ToggleOffHoverBackgroundBrush" Color="#363B43" />
            <SolidColorBrush x:Key="ToggleOffHoverBorderBrush" Color="#555D68" />

            <SolidColorBrush x:Key="ToggleOnBackgroundBrush" Color="#087F74" />
            <SolidColorBrush x:Key="ToggleOnBorderBrush" Color="#35C9AE" />
            <SolidColorBrush x:Key="ToggleOnHoverBackgroundBrush" Color="#11998C" />
            <SolidColorBrush x:Key="ToggleOnHoverBorderBrush" Color="#35C9AE" />
            <SolidColorBrush x:Key="ToggleKnobBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="ElectricForegroundBrush" Color="#72AEFF" />
            <SolidColorBrush x:Key="ElectricBackgroundBrush" Color="#26384E" />
            <SolidColorBrush x:Key="PositiveTextBrush" Color="#35C9AE" />

            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,100%" EndPoint="0%,0%">
                <GradientStop Offset="0" Color="#109989" />
                <GradientStop Offset="1" Color="#35C9AE" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FF7777" />
            <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#3A292C" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#70464C" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#172033" />

            <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#F3F5F8" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#DCE2EA" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="#E7EBF1" />

            <SolidColorBrush x:Key="BodyTextBrush" Color="#344054" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#667085" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#8A94A6" />

            <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#F1F4F8" />
            <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#C7D0DD" />

            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#C9D1DE" />

            <SolidColorBrush x:Key="ToggleOffBackgroundBrush" Color="#E9EDF3" />
            <SolidColorBrush x:Key="ToggleOffBorderBrush" Color="#C9D1DE" />
            <SolidColorBrush x:Key="ToggleOffHoverBackgroundBrush" Color="#DDE3EC" />
            <SolidColorBrush x:Key="ToggleOffHoverBorderBrush" Color="#ADB8C8" />

            <SolidColorBrush x:Key="ToggleOnBackgroundBrush" Color="#087F74" />
            <SolidColorBrush x:Key="ToggleOnBorderBrush" Color="#17A99B" />
            <SolidColorBrush x:Key="ToggleOnHoverBackgroundBrush" Color="#11998C" />
            <SolidColorBrush x:Key="ToggleOnHoverBorderBrush" Color="#17A99B" />
            <SolidColorBrush x:Key="ToggleKnobBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="ElectricForegroundBrush" Color="#286BCE" />
            <SolidColorBrush x:Key="ElectricBackgroundBrush" Color="#EAF2FF" />
            <SolidColorBrush x:Key="PositiveTextBrush" Color="#087F6B" />

            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,100%" EndPoint="0%,0%">
                <GradientStop Offset="0" Color="#087F74" />
                <GradientStop Offset="1" Color="#17A99B" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#C73E62" />
            <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#FFF0F3" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#F2C6D1" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

