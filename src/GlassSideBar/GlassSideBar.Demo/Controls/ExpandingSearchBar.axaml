<UserControl
    x:Class="GlassSideBar.Demo.Controls.ExpandingSearchBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GlassSideBar.Demo.Controls"
    xmlns:sys="using:System"
    ClipToBounds="False">
    <UserControl.Resources>
        <sys:TimeSpan x:Key="ExpandDuration">0:0:0.25</sys:TimeSpan>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ToggleButton.searchBar">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition
                        Easing="CubicEaseOut"
                        Property="Width"
                        Duration="{DynamicResource ExpandDuration}" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="Container"
                        Background="{DynamicResource ItemBgTransparent}"
                        BorderBrush="{DynamicResource ItemBorder}"
                        BorderThickness="1"
                        BoxShadow="0 4 15 0 #20000000"
                        CornerRadius="22">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="{DynamicResource ExpandDuration}" />
                                <BrushTransition Property="BorderBrush" Duration="{DynamicResource ExpandDuration}" />
                            </Transitions>
                        </Border.Transitions>
                        <Grid>
                            <Border
                                Width="44"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                Cursor="Hand">
                                <Path
                                    Name="SearchIcon"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                    Fill="{DynamicResource IconDefaultBrush}"
                                    Stretch="Uniform">
                                    <Path.Transitions>
                                        <Transitions>
                                            <BrushTransition Property="Fill" Duration="0:0:0.3" />
                                        </Transitions>
                                    </Path.Transitions>
                                </Path>
                            </Border>
                            <TextBox
                                Name="InputBox"
                                Margin="44,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                CaretBrush="{DynamicResource PrimaryTextBrush}"
                                FontSize="14"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                IsHitTestVisible="False"
                                Opacity="0"
                                PlaceholderText="Search...">
                                <TextBox.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                    </Transitions>
                                </TextBox.Transitions>
                            </TextBox>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!--  Expanded/Collapsed States & Cursors  -->
        <Style Selector="ToggleButton.searchBar:checked">
            <Setter Property="Width" Value="250" />
            <Setter Property="Cursor" Value="IBeam" />
        </Style>
        <Style Selector="ToggleButton.searchBar:unchecked">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.searchBar:checked /template/ TextBox#InputBox">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <!--  Container Background & Border States  -->
        <Style Selector="ToggleButton.searchBar /template/ Border#Container">
            <Setter Property="Background" Value="{DynamicResource ItemBgHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ItemBorder}" />
        </Style>
        <Style Selector="ToggleButton.searchBar:not(:checked):pointerover /template/ Border#Container">
            <Setter Property="Background" Value="{DynamicResource ItemBgSelected}" />
        </Style>
        <Style Selector="ToggleButton.searchBar:checked:focus-within /template/ Border#Container">
            <Setter Property="Background" Value="{DynamicResource ItemBgSelected}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ItemBorder}" />
        </Style>

        <!--  Icon States  -->
        <Style Selector="ToggleButton.searchBar /template/ Path#SearchIcon">
            <Setter Property="Fill" Value="{DynamicResource IconDefaultBrush}" />
        </Style>
        <Style Selector="ToggleButton.searchBar:checked /template/ Path#SearchIcon">
            <Setter Property="Fill" Value="{DynamicResource IconActiveBrush}" />
        </Style>

        <!--  TextBox Interaction & Colors  -->
        <Style Selector="ToggleButton.searchBar /template/ TextBox#InputBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource ItemBorder}" />
        </Style>
        <Style Selector="ToggleButton.searchBar /template/ TextBox#InputBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="IBeam" />
        </Style>
        <Style Selector="ToggleButton.searchBar /template/ TextBox#InputBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>

    <ToggleButton
        Name="MainButton"
        Classes="searchBar"
        ClipToBounds="False"
        IsChecked="{Binding $parent[controls:ExpandingSearchBar].IsExpanded}"
        IsCheckedChanged="MainButton_OnChecked" />
</UserControl>