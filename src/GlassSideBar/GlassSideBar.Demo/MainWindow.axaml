<Window
    x:Class="GlassSideBar.Demo.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GlassSideBar.Demo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GlassSideBar.Demo"
    Width="1280"
    Height="720"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource WorkspaceBackgroundBrush}"
    mc:Ignorable="d">

    <local:GlassSideBarDemo HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
</Window>
